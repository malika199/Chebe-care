PORT=3001
# Fortement recommandé en prod (Railway, Render, etc.) : URL publique EXACTE de cette API (HTTPS, sans / final).
# Sans ça, le site peut charger les produits mais pas les images (Host vu par Node ≠ URL réelle).
# PUBLIC_BASE_URL=https://xxxx.up.railway.app
# Par défaut : admin123 (à modifier dans server/.env)
# Email admin unique (login)
ADMIN_EMAIL=chebecare0@gmail.com
# Mot de passe temporaire utilisé uniquement à l'initialisation du fichier admin.json
ADMIN_TEMP_PASSWORD=ChangeMe123!
# Mettre à true une seule fois pour forcer la recréation du compte admin
# avec ADMIN_EMAIL + ADMIN_TEMP_PASSWORD, puis remettre à false.
ADMIN_FORCE_BOOTSTRAP=false
# Secret JWT (obligatoire en production)
ADMIN_JWT_SECRET=change-this-secret
# URL publique de l'admin (pour construire le lien reset), ex: https://admin.chebecare.fr
# ADMIN_APP_URL=https://votre-admin-url
# Boîte mail sur Hostinger (MX hostinger) :
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=votre_adresse@votredomaine.fr
SMTP_PASS=mot_de_passe_boite_mail
SMTP_FROM="Boutique Admin <votre_adresse@votredomaine.fr>"
