PORT=3001
# Fortement recommandé en prod (Railway, Render, etc.) : URL publique EXACTE de cette API (HTTPS, sans / final).
# Sans ça, le site peut charger les produits mais pas les images (Host vu par Node ≠ URL réelle).
# PUBLIC_BASE_URL=https://xxxx.up.railway.app
# Par défaut : admin123 (à modifier dans server/.env)
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@exemple.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
# Obligatoire pour Gmail : mot de passe d’application (compte Google → Sécurité → Validation en 2 étapes → Mots de passe des applications), pas le mot de passe du compte.
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM="Boutique Admin <votre_email@gmail.com>"
