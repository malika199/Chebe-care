PORT=3001
# Dossiers persistants (optionnel, recommandé sur Render avec Disk mounté)
# Exemple Render : DATA_DIR=/var/data/data et IMAGES_DIR=/var/data/images
# DATA_DIR=/var/data/data
# IMAGES_DIR=/var/data/images

# --- Admin (fichier data/admin.json) ---
ADMIN_EMAIL=chebecare0@gmail.com
ADMIN_TEMP_PASSWORD=ChangeMe123!
# true = réinitialise le compte admin au démarrage avec ADMIN_EMAIL + ADMIN_TEMP_PASSWORD
# (utile pour récupérer l'accès, puis repasser à false après connexion)
ADMIN_FORCE_BOOTSTRAP=false
# Lien dans l’email de reset : domaine public de l’admin (HTTPS, sans / final)
ADMIN_APP_URL=https://chebe-care.onrender.com

# URL publique de cette API (images, etc.) — fortement recommandé sur Render / Railway
# PUBLIC_BASE_URL=https://votre-api.onrender.com

# --- SMTP (obligatoire pour « mot de passe oublié » admin) ---
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_USER=votre@gmail.com, SMTP_PASS=mot_de_passe_application_Google
# Hostinger : voir la doc (souvent smtp.hostinger.com)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=chebecare0@gmail.com
SMTP_PASS="xihfprajkujmnrer"
SMTP_FROM="Boutique <chebecare0@gmail.com>"

# IPv4 uniquement pour la connexion SMTP (réduit ETIMEDOUT) :
# - sur Render : activé automatiquement (RENDER=true), sauf si vous mettez SMTP_FORCE_IPV4=false
# - en local / autre : mettre SMTP_FORCE_IPV4=true si besoin
SMTP_FORCE_IPV4=false
# SMTP_FORCE_IPV4=false

# Délai total HTTP pour l’envoi (évite 502 sur Render ~30s). Défaut 26000 ms
SMTP_HTTP_BUDGET_MS=20000
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=8000
# SMTP_CONNECTION_TIMEOUT_MS=7000
# SMTP_GREETING_TIMEOUT_MS=6000
# SMTP_SOCKET_TIMEOUT_MS=10000

# STARTTLS strict sur 587 (défaut : désactivé, évite ESOCKET sur certains fournisseurs)
# SMTP_REQUIRE_TLS=true

# Dernier recours si certificat SMTP refusé (risque MITM)
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# 2e passe réseau après échec (allonge la requête)
# SMTP_OUTER_NETWORK_RETRY=true
