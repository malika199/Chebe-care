# Production : URL publique de ton API (HTTPS, sans slash final). Ex. https://api.tondomaine.com
# Au build : npm run build lit cette variable et l’intègre au JS.
# Sans rebuild : dans client/index.html, décommente et remplis <meta name="api-base-url" content="..." />.
# En local (npm run dev), laisse vide : le proxy Vite envoie /api et /images vers le serveur.
VITE_API_URL="https://chebe-care.onrender.com/api"
